# Event Manager starts without this file and reads process/container environment directly.
# Copy this example to an untracked location only when a file is more convenient.

# local: never opens the registry database.
# database: synchronizes the registry database and falls back to the local snapshot if unavailable.
# auto: uses the database when a METADB profile is configured, otherwise stays local.
EA_EVENT_MANAGER_MODE=local

# Local registry state. If omitted, Event Manager uses its surface-specific default.
EA_REGISTRY_SNAPSHOT_PATH=

# Optional runtime plugins. Security and Perch implementations are distributed separately.
EA_PLUGIN_ROOT=
EA_PLUGIN_INTEGRITY_MODE=required
EA_PLUGIN_INTEGRITY_MANIFEST=
EA_REQUIRED_PLUGIN_IDS=

# One logging root shared by the platform. Event Manager writes below event-manager/;
# DITTOE writes below dittoe/.
EA_LOG_ROOT=logs

EVENT_ENGINE_HTTP_HOST=127.0.0.1
EVENT_ENGINE_HTTP_PORT=8080
EA_QUEUE_ENABLED=false

# Authenticated Socket.IO transport limits.
EA_SOCKET_IO_MAX_TEXT_MESSAGE_BYTES=65536
EA_SOCKET_IO_IDLE_TIMEOUT_SECONDS=60
EA_SOCKET_IO_MAX_CONNECTIONS=500
EA_SOCKET_IO_MAX_EVENTS_PER_MINUTE=120
EA_SOCKET_IO_MAX_ROOMS_PER_CONNECTION=32
EA_SOCKET_IO_TOKEN_REVALIDATION_SECONDS=30

# Optional registry database profile for database or auto mode.
METADB.DB_HOST=localhost
METADB.DB_PORT=5432
METADB.DB_NAME=event_manager_registry
METADB.DB_USERNAME=event_manager
METADB.DB_PASSWORD=replace-me
METADB.DB_SSL=false

# Non-loopback database hosts should use TLS. Set this only for an explicitly
# accepted plaintext development connection.
EA_ALLOW_PLAINTEXT_DB=false
